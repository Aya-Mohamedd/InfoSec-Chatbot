# =============================================================================
# ollama.service
# CISC 886 — Cloud Computing
#
# This systemd unit file ensures Ollama starts automatically every time
# the EC2 instance reboots — satisfying Section 7's auto-start requirement.
#
# Location on EC2: /etc/systemd/system/ollama.service
# The bootstrap script writes this file automatically, but it is included
# here as a reference and for troubleshooting.
#
# After editing this file manually, always run:
#   sudo systemctl daemon-reload
#   sudo systemctl restart ollama
# =============================================================================

[Unit]
Description=Ollama LLM Server
# Ensure networking is up before starting — Ollama needs the network
# to serve its API on 0.0.0.0:11434
After=network.target

[Service]
Type=simple
User=root

# OLLAMA_HOST=0.0.0.0 makes Ollama listen on all network interfaces,
# not just localhost. This is required so OpenWebUI (running in Docker)
# can reach the Ollama API, and so the curl test works from outside.
Environment=OLLAMA_HOST=0.0.0.0

ExecStart=/usr/local/bin/ollama serve

# Restart=always means systemd will restart Ollama if it crashes or is
# killed unexpectedly. RestartSec=3 waits 3 seconds before restarting
# to avoid rapid restart loops.
Restart=always
RestartSec=3

[Install]
# WantedBy=multi-user.target means this service starts in normal
# multi-user mode (i.e., every time the system boots normally).
WantedBy=multi-user.target
